provider_installation {
  # Provider は /opt/terraform/providers の展開済み filesystem mirror からのみ取得する。
  # このディレクトリは、イメージのビルド時に
  # `terraform providers mirror` の出力を展開して作成する。
  # terraform init は各プロジェクトの .terraform/providers から
  # このディレクトリへのシンボリックリンクを作成できる。
  # `direct` を定義しないため、Provider Registry からは取得しない。
  # Provider の取得ではインターネット接続を必要としない。
  filesystem_mirror {
    path = "/opt/terraform/providers"
  }
}
